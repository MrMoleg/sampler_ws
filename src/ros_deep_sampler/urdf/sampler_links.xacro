        </link> -->


        <!-- ================= DRILL ROTOR ================= -->

        <link name="${prefix}rotor_link">

            <visual>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <material name="green">
                    <color rgba="0.2 0.8 0.2 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>

            <inertial>
                <mass value="0.5"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.0022" ixy="0.0" ixz="0.0"
                    iyy="0.0022" iyz="0.0"
                    izz="0.0004"/>
            </inertial>

        </link>


        <!-- ================= VACUUM BODY ================= -->

        <link name="${prefix}vaccum_body_link">

            <visual>
                <geometry>
                    <box size="0.1 0.1 0.15"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <material name="blue">
                    <color rgba="0.2 0.3 0.8 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.1 0.1 0.15"/>
                </geometry>
            </collision>

            <inertial>
                <mass value="5.0"/>
                <origin xyz="0 0 0"/>

                <inertia
                    ixx="0.2" ixy="0.0" ixz="0.0"
                    iyy="0.2" iyz="0.0"
                    izz="0.2"/>
            </inertial>

        </link>


        <!-- ================= VACUUM ROTOR ================= -->

        <link name="${prefix}vacuum_rotor_link">

            <visual>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <material name="green">
                    <color rgba="0.2 0.8 0.2 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>

            <inertial>
                <mass value="0.5"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.0022" ixy="0.0" ixz="0.0"
                    iyy="0.0022" iyz="0.0"
                    izz="0.0004"/>
            </inertial>

        </link>


        <!-- ================= BRUSH ROTOR ================= -->

        <link name="${prefix}brush_rotor_link">

            <visual>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>

                <material name="green">
                    <color rgba="0.2 0.8 0.2 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.07 0.07 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>

            <inertial>
                <mass value="0.5"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.0022" ixy="0.0" ixz="0.0"
                    iyy="0.0022" iyz="0.0"
                    izz="0.0004"/>
            </inertial>

        </link>


        <!-- ================= CONTAINER ================= -->

        <link name="${prefix}container_link">

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <box size="0.7 0.2 0.02"/>
                </geometry>

                <material name="blue">
                    <color rgba="0 0.4 1 1"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <box size="0.7 0.1 0.02"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <mass value="1.0"/>

                <inertia
                    ixx="0.01" ixy="0.0" ixz="0.0"
                    iyy="0.01" iyz="0.0"
                    izz="0.01"/>
            </inertial>

        </link>


        <!-- ================= CONTAINER VELOCITY BRANCH ================= -->

        <!-- <link name="${prefix}container_link1">

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
