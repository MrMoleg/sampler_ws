        <!-- ================= DRILL ================= -->

        <link name="${prefix}drill_link">

            <visual>
                <geometry>
                    <box size="0.05 0.6 0.05"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </visual>

            <collision>
                <geometry>
                    <box size="0.05 0.6 0.05"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </collision>

            <inertial>
                <mass value="3.0"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.01" ixy="0.0" ixz="0.0"
                    iyy="0.01" iyz="0.0"
                    izz="0.01"/>
            </inertial>

        </link>


        <!-- ================= DRILL VELOCITY BRANCH ================= -->

        <!-- <link name="${prefix}drill_link1">

            <visual>
                <geometry>
                    <box size="0.05 0.6 0.05"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </visual>

            <collision>
                <geometry>
                    <box size="0.05 0.6 0.05"/>
                </geometry>

