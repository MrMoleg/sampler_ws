<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        Sampler robot link definitions.

        Parameter:
            prefix - Optional prefix applied to all link names.
    -->

    <xacro:macro name="sampler_links" params="prefix:=''">

        <!-- ================= WORLD ================= -->

        <link name="${prefix}world"/>


        <!-- ================= BASE PLATFORM ================= -->

        <link name="${prefix}base_link">

            <visual>
                <geometry>
                    <box size="0.5 0.5 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 1.5707 0"/>

                <material name="gray">
                    <color rgba="0.6 0.6 0.6 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.5 0.5 0.02"/>
                </geometry>

                <origin xyz="0 0 0" rpy="0 1.5707 0"/>
            </collision>

            <inertial>
                <mass value="2.0"/>
                <origin xyz="0 0 1" rpy="0 1.5707 0"/>

                <inertia
                    ixx="0.02" ixy="0.0" ixz="0.0"
                    iyy="0.02" iyz="0.0"
                    izz="0.04"/>
            </inertial>

        </link>


        <!-- ================= PLATFORM ================= -->

        <link name="${prefix}platform_link">

            <visual>
                <geometry>
                    <box size="0.1 0.6 0.1"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>

                <material name="blue">
                    <color rgba="0.2 0.2 0.8 1.0"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.1 0.6 0.1"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </collision>

            <inertial>
                <mass value="5.0"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.154" ixy="0.0" ixz="0.0"
                    iyy="0.008" iyz="0.0"
                    izz="0.154"/>
            </inertial>

        </link>


        <!-- ================= PLATFORM VELOCITY BRANCH ================= -->

        <!-- <link name="${prefix}platform_link1">

            <visual>
                <geometry>
                    <box size="0.1 0.6 0.1"/>
                </geometry>

                <origin xyz="0 0 0" rpy="1.5707 0 0"/>

                <material name="blue">
                    <color rgba="0.2 0.2 0.8 1.0"/>
                </material>
