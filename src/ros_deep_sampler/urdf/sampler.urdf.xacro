<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sampler">

    <!-- Xacro arguments -->
    <xacro:arg name="ros2_control" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>

    <!-- Component definitions -->
    <xacro:include filename="$(find ros_deep_sampler)/urdf/sampler_links.xacro"/>
    <xacro:include filename="$(find ros_deep_sampler)/urdf/sampler_joints.xacro"/>
    <xacro:include filename="$(find ros_deep_sampler)/urdf/sampler_ros2_control.xacro"/>
    <xacro:include filename="$(find ros_deep_sampler)/urdf/sampler_gazebo.xacro"/>

    <!-- Main robot macro -->
    <xacro:macro name="sampler_robot"
        params="
            parent:='world'
            xyz:='0 0 0'
            rpy:='0 0 0'
            ros2_control:=false
            use_gazebo:=false
            use_mock_hardware:=false
            prefix:=''
        ">

        <!-- Mechanical structure -->
        <xacro:sampler_links prefix="${prefix}"/>
        <xacro:sampler_joints prefix="${prefix}"/>

        

        <!-- ROS 2 Control -->
        <xacro:if value="${ros2_control}">
            <xacro:sampler_ros2_control
                use_gazebo="${use_gazebo}"
                use_mock_hardware="${use_mock_hardware}"
                prefix="${prefix}"/>
        </xacro:if>

        <!-- Gazebo -->
        <xacro:if value="${use_gazebo}">
            <xacro:sampler_gazebo/>
        </xacro:if>

    </xacro:macro>

    <!-- Instantiate robot -->
    <xacro:sampler_robot
        ros2_control="$(arg ros2_control)"
        use_gazebo="$(arg use_gazebo)"
        use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>