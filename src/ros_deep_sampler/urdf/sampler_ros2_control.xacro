<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="sampler_ros2_control"
                 params="use_gazebo:=false
                         use_mock_hardware:=false
                         prefix:=''">

        <ros2_control name="${prefix}SamplerSystem" type="system">

            <hardware>

                <!-- Gazebo simulation -->
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>

                <!-- Mock hardware -->
                <xacro:if value="${use_mock_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>

                <!-- Physical hardware -->
                <xacro:if value="${not use_gazebo and not use_mock_hardware}">
                    <plugin>sampler_hardware_interfaces/SamplerHardware</plugin>
                    <param name="can_interface">can0</param>
                </xacro:if>

            </hardware>

            <!-- Platform -->
            <joint name="${prefix}platform_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Drill -->
            <joint name="${prefix}drill_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Main rotor -->
            <joint name="${prefix}rotor_joint">
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Vacuum rotor -->
            <joint name="${prefix}vacuum_rotor_joint">
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Brush rotor -->
            <joint name="${prefix}brush_rotor_joint">
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Container -->
            <joint name="${prefix}container_joint">
                <command_interface name="position"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            <!-- Clamp -->
            <joint name="${prefix}clamp_joint">
                <command_interface name="position"/>

                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>

                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>