<?xml version="1.0"?>
<robot name="sampler" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="SamplerHardwareSystem" type="system">

     <hardware>
        <xacro:if value="$(arg use_gazebo)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:unless value="$(arg use_gazebo)">
        <plugin>sampler_hardware_interfaces/SamplerHardware</plugin>
        </xacro:unless>
    </hardware>


    <!-- =============================================== -->
    <!-- Platform                                       -->
    <!-- =============================================== -->

    <joint name="platform_joint">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>

      <command_interface name="velocity">
        <param name="min">-5.0</param>
        <param name="max">5.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Drill                                          -->
    <!-- =============================================== -->

    <joint name="drill_joint">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>

      <command_interface name="velocity">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Drill rotor                                    -->
    <!-- =============================================== -->

    <joint name="rotor_joint">
      <command_interface name="velocity">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Vacuum rotor                                   -->
    <!-- =============================================== -->

    <joint name="vacuum_rotor_joint">
      <command_interface name="velocity">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Brush rotor                                    -->
    <!-- =============================================== -->

    <joint name="brush_rotor_joint">
      <command_interface name="velocity">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Container                                      -->
    <!-- =============================================== -->

    <joint name="container_joint">
      <command_interface name="position">
        <param name="min">-1.6</param>
        <param name="max">1.6</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- =============================================== -->
    <!-- Clamp                                          -->
    <!-- =============================================== -->

    <joint name="clamp_joint">
      <command_interface name="position">
        <param name="min">-1.6</param>
        <param name="max">1.6</param>
      </command_interface>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>